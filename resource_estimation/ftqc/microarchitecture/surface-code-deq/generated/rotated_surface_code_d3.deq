# Port 0 is the control and port 1 is the target.
# Internal port 2 is a |+> mediator patch.
COMPOSE FaultTolerantCNOTD3 {
    INPUT RotatedSurfaceCodeW3H3 0
    INPUT RotatedSurfaceCodeW3H3 1
    PrepareX 2
    FaultTolerantMZZD3 0 2
    FaultTolerantMXXD3 2 1
    MeasureZ 2
    # Record order: mZZ, mXX, mZ_mediator.
    CONDITIONAL rec[-2] Z0 0
    CONDITIONAL rec[-3] X0 1
    CONDITIONAL rec[-1] X0 1
    OUTPUT RotatedSurfaceCodeW3H3 0
    OUTPUT RotatedSurfaceCodeW3H3 1
}
