    OUTPUT YBoundaryStateD3 1 2 3 4 5 6 7 8
}

GADGET PrepareYBoundarySED3 {
    INPUT YBoundaryStateD3 1 2 3 4 5 6 7 8
    # One additional XXZZ-boundary syndrome-extraction round.
    R 18 19 21 23
    RX 20 22 24 25
    CX 1 18 3 19 20 4 22 6 7 23 24 8
    CX 20 5 22 7 4 23
    CX 2 18 4 19 20 1 6 21 22 3 8 23 24 5 25 7
    CX 1 19 20 2 3 21 22 4 5 23 25 8
