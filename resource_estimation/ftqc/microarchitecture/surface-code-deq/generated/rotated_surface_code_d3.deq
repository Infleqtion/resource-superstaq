    CX 30 18 19 31 21 33 34 22 40 27 32 20
    M 18 22 42 20
    MX 19 21 40 25
    OUTPUT RotatedSurfaceCodeW3H3 27 28 29 30 31 32 33 34 35
}

# The transient codes make each deformation boundary explicit.
COMPOSE LogicalHadamardD3 {
    INPUT RotatedSurfaceCodeW3H3 0
    TransversalHadamardD3 IN(0) OUT(1)
    HadamardExtendD3 IN(1) OUT(2)
    REPEAT 2 {
        HadamardExtensionSED3 2
    }
    HadamardCornerMoveD3 IN(2) OUT(3)
    REPEAT 2 {
        HadamardDomainWallSED3 3
    }
    HadamardShrinkD3 IN(3) OUT(4)
    HadamardReturnExtendD3 IN(4) OUT(5)
    REPEAT 2 {
        HadamardReturnExtensionSED3 5
    }
    HadamardReturnShrinkD3 IN(5) OUT(6)
    HadamardSwapQECD3 IN(6) OUT(7)
    OUTPUT RotatedSurfaceCodeW3H3 7
}

# Port 0 is the control and port 1 is the target.
# Internal port 2 is a |+> mediator patch.
COMPOSE LogicalCNOTD3 {
    INPUT RotatedSurfaceCodeW3H3 0
    INPUT RotatedSurfaceCodeW3H3 1
    PrepareX 2
    FaultTolerantMZZD3 0 2
    FaultTolerantMXXD3 2 1
    MeasureZ 2
    # Record order: mZZ, mXX, mZ_mediator.
    CONDITIONAL rec[-2] Z0 0
    CONDITIONAL rec[-3] X0 1
    CONDITIONAL rec[-1] X0 1
    OUTPUT RotatedSurfaceCodeW3H3 0
    OUTPUT RotatedSurfaceCodeW3H3 1
}

# Inject a logical S using an encoded |+i> = S|+> resource state.
# Port 0 is the data patch; internal port 1 is the consumed |+i> patch.
COMPOSE LogicalSD3 {
    INPUT RotatedSurfaceCodeW3H3 0
    PrepareY 1
    LogicalCNOTD3 0 1
    MeasureZ 1
    # A 1 outcome leaves Z*S on the data, so update its Z frame.
    CONDITIONAL rec[-1] Z0 0
    OUTPUT RotatedSurfaceCodeW3H3 0
}