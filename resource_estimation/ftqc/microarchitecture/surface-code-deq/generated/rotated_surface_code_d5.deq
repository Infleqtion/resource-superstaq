COMPOSE FaultTolerantMZZD5 {
    INPUT RotatedSurfaceCodeW5H5 0
    INPUT RotatedSurfaceCodeW5H5 1
    MergeBeginZZ IN(0 1) OUT(0)
    REPEAT 5 {
        MergedSEZZ 0
    }
    MergeEndZZ IN(0) OUT(0 1)
    # Keep patch B's measured-basis frame, rather than DEQ's default
    # measure-and-reset interpretation. rec[-1] is MergeBegin's joint parity:
    # MXX needs a logical Z correction; MZZ needs logical X.
    CONDITIONAL rec[-1] X0 1
    OUTPUT RotatedSurfaceCodeW5H5 0
    OUTPUT RotatedSurfaceCodeW5H5 1
}

PROGRAM FaultTolerantMXXD5MemoryX {
    PrepareX 0
    PrepareX 1
    FaultTolerantMXXD5 0 1
    MeasureX 0
    MeasureX 1
    ASSERT_EQ rec[-3] 0
    ASSERT_EQ rec[-2] 0
    ASSERT_EQ rec[-1] 0
}

# These measured-basis eigenstate cases verify the joint parity and that both
# output frames are preserved. They catch DEQ's default measure-and-reset
# interpretation, which would copy patch A's frame onto patch B.
PROGRAM FaultTolerantMXXD5FrameA {
    PrepareX 0
    PrepareX 1
    LogicalZ 0
    FaultTolerantMXXD5 0 1
    MeasureX 0
    MeasureX 1
    ASSERT_EQ rec[-3] 1
    ASSERT_EQ rec[-2] 1
    ASSERT_EQ rec[-1] 0
}

PROGRAM FaultTolerantMXXD5FrameB {
    PrepareX 0
    PrepareX 1
    LogicalZ 1
    FaultTolerantMXXD5 0 1
    MeasureX 0
    MeasureX 1
    ASSERT_EQ rec[-3] 1
    ASSERT_EQ rec[-2] 0
    ASSERT_EQ rec[-1] 1
}

PROGRAM FaultTolerantMXXD5FrameBoth {
    PrepareX 0
    PrepareX 1
    LogicalZ 0
    LogicalZ 1
    FaultTolerantMXXD5 0 1
    MeasureX 0
    MeasureX 1
    ASSERT_EQ rec[-3] 0
    ASSERT_EQ rec[-2] 1
    ASSERT_EQ rec[-1] 1
}

