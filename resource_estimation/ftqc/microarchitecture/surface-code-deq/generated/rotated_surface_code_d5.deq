    OUTPUT RotatedSurfaceCodeW5H5 75 76 77 78 79 80 81 82 83 84 85 86 87 88 89 90 91 92 93 94 95 96 97 98 99
}

# The transient codes make each deformation boundary explicit.
COMPOSE LogicalHadamardD5 {
    INPUT RotatedSurfaceCodeW5H5 0
    TransversalHadamardD5 IN(0) OUT(1)
    HadamardExtendD5 IN(1) OUT(2)
    REPEAT 4 {
        HadamardExtensionSED5 2
    }
    HadamardCornerMoveD5 IN(2) OUT(3)
    REPEAT 4 {
        HadamardDomainWallSED5 3
    }
    HadamardShrinkD5 IN(3) OUT(4)
    HadamardReturnExtendD5 IN(4) OUT(5)
    REPEAT 4 {
        HadamardReturnExtensionSED5 5
    }
    HadamardReturnShrinkD5 IN(5) OUT(6)
    HadamardSwapQECD5 IN(6) OUT(7)
    OUTPUT RotatedSurfaceCodeW5H5 7
}

# Port 0 is the control and port 1 is the target.
# Internal port 2 is a |+> mediator patch.
COMPOSE LogicalCNOTD5 {
    INPUT RotatedSurfaceCodeW5H5 0
    INPUT RotatedSurfaceCodeW5H5 1
    PrepareX 2
    FaultTolerantMZZD5 0 2
    FaultTolerantMXXD5 2 1
    MeasureZ 2
    # Record order: mZZ, mXX, mZ_mediator.
    CONDITIONAL rec[-2] Z0 0
    CONDITIONAL rec[-3] X0 1
    CONDITIONAL rec[-1] X0 1
    OUTPUT RotatedSurfaceCodeW5H5 0
    OUTPUT RotatedSurfaceCodeW5H5 1
}

# Inject a logical S using an encoded |+i> = S|+> resource state.
# Port 0 is the data patch; internal port 1 is the consumed |+i> patch.
COMPOSE LogicalSD5 {
    INPUT RotatedSurfaceCodeW5H5 0
    PrepareY 1
    LogicalCNOTD5 0 1
    MeasureZ 1
    # A 1 outcome leaves Z*S on the data, so update its Z frame.
    CONDITIONAL rec[-1] Z0 0
    OUTPUT RotatedSurfaceCodeW5H5 0
}