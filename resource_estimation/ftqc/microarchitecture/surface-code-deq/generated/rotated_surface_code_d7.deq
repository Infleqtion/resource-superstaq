# The transient codes make each deformation boundary explicit.
COMPOSE LogicalHadamardD7 {
    INPUT RotatedSurfaceCodeW7H7 0
    TransversalHadamardD7 IN(0) OUT(1)
    HadamardExtendD7 IN(1) OUT(2)
    REPEAT 6 {
        HadamardExtensionSED7 2
    }
    HadamardCornerMoveD7 IN(2) OUT(3)
    REPEAT 6 {
        HadamardDomainWallSED7 3
    }
    HadamardShrinkD7 IN(3) OUT(4)
    HadamardReturnExtendD7 IN(4) OUT(5)
    REPEAT 6 {
        HadamardReturnExtensionSED7 5
    }
    HadamardReturnShrinkD7 IN(5) OUT(6)
    HadamardSwapQECD7 IN(6) OUT(7)
    OUTPUT RotatedSurfaceCodeW7H7 7
}

# Port 0 is the control and port 1 is the target.
# Internal port 2 is a |+> mediator patch.
COMPOSE FaultTolerantCNOTD7 {
    INPUT RotatedSurfaceCodeW7H7 0
    INPUT RotatedSurfaceCodeW7H7 1
    PrepareX 2
    FaultTolerantMZZD7 0 2
    FaultTolerantMXXD7 2 1
    MeasureZ 2
    # Record order: mZZ, mXX, mZ_mediator.
    CONDITIONAL rec[-2] Z0 0
    CONDITIONAL rec[-3] X0 1
    CONDITIONAL rec[-1] X0 1
    OUTPUT RotatedSurfaceCodeW7H7 0
    OUTPUT RotatedSurfaceCodeW7H7 1
}

# Inject a logical S using an encoded |+i> = S|+> resource state.
# Port 0 is the data patch; internal port 1 is the consumed |+i> patch.
COMPOSE LogicalSD7 {
    INPUT RotatedSurfaceCodeW7H7 0
    PrepareY 1
    FaultTolerantCNOTD7 0 1
    MeasureZ 1
    # A 1 outcome leaves Z*S on the data, so update its Z frame.
    CONDITIONAL rec[-1] Z0 0
    OUTPUT RotatedSurfaceCodeW7H7 0
}