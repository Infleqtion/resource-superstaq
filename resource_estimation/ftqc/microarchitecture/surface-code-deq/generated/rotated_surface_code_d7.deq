COMPOSE RotatedSurfaceCodeMemoryD7 {
    INPUT RotatedSurfaceCodeW7H7 0
    REPEAT 7 {
        SyndromeExtraction 0
    }
    OUTPUT RotatedSurfaceCodeW7H7 0
}

COMPOSE FaultTolerantMXXD7 {
    INPUT RotatedSurfaceCodeW7H7 0
    INPUT RotatedSurfaceCodeW7H7 1
    MergeBeginXX IN(0 1) OUT(0)
    REPEAT 7 {
        MergedSEXX 0
    }
    MergeEndXX IN(0) OUT(0 1)
    # Keep patch B's measured-basis frame, rather than DEQ's default
    # measure-and-reset interpretation. rec[-1] is MergeBegin's joint parity:
    # MXX needs a logical Z correction; MZZ needs logical X.
    CONDITIONAL rec[-1] Z0 1
    OUTPUT RotatedSurfaceCodeW7H7 0
    OUTPUT RotatedSurfaceCodeW7H7 1
}

COMPOSE FaultTolerantMZZD7 {
    INPUT RotatedSurfaceCodeW7H7 0
    INPUT RotatedSurfaceCodeW7H7 1
    MergeBeginZZ IN(0 1) OUT(0)
    REPEAT 7 {
        MergedSEZZ 0
    }
    MergeEndZZ IN(0) OUT(0 1)
    # Keep patch B's measured-basis frame, rather than DEQ's default
    # measure-and-reset interpretation. rec[-1] is MergeBegin's joint parity:
    # MXX needs a logical Z correction; MZZ needs logical X.
    CONDITIONAL rec[-1] X0 1
    OUTPUT RotatedSurfaceCodeW7H7 0
    OUTPUT RotatedSurfaceCodeW7H7 1
}

PROGRAM FaultTolerantMXXD7MemoryX {
    PrepareX 0
    PrepareX 1
    FaultTolerantMXXD7 0 1
    MeasureX 0
    MeasureX 1
    ASSERT_EQ rec[-3] 0
    ASSERT_EQ rec[-2] 0
    ASSERT_EQ rec[-1] 0
}

# These measured-basis eigenstate cases verify the joint parity and that both
# output frames are preserved. They catch DEQ's default measure-and-reset
# interpretation, which would copy patch A's frame onto patch B.
PROGRAM FaultTolerantMXXD7FrameA {
    PrepareX 0
    PrepareX 1
    LogicalZ 0
    FaultTolerantMXXD7 0 1
    MeasureX 0
    MeasureX 1
    ASSERT_EQ rec[-3] 1
    ASSERT_EQ rec[-2] 1
    ASSERT_EQ rec[-1] 0
}

